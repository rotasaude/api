# Kamal secrets — development
# Lido pelo Kamal como shell script. Valores NUNCA aparecem aqui em texto plano.
# Ver ADR-0011.
#
# Em dev aceitamos fallback para .env.development.local (na raiz de apps/api/),
# ignorado pelo git. Em prod, vem só do cofre (ver production/secrets).

# Carrega .env.development.local se existir (formato KEY=value, uma por linha).
if [ -f "${KAMAL_CONFIG_DIR:-.}/.env.development.local" ]; then
  set -o allexport
  . "${KAMAL_CONFIG_DIR:-.}/.env.development.local"
  set +o allexport
fi

# Registry — token de leitura/escrita do ghcr para o usuário rota-saude-bot.
KAMAL_REGISTRY_PASSWORD=${KAMAL_REGISTRY_PASSWORD:?defina no .env.development.local}

# Rails master key (config/credentials/development.key — NUNCA commitada).
RAILS_MASTER_KEY=${RAILS_MASTER_KEY:?defina no .env.development.local}

# Postgres do accessory (mesma máquina em dev).
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:?defina no .env.development.local}
DATABASE_URL=${DATABASE_URL:-postgres://rota_saude:${POSTGRES_PASSWORD}@127.0.0.1:5432/rota_saude_development}

# Senhas dos papéis Postgres (defaults iguais aos do docker-compose de dev).
ROTA_APP_PASSWORD=${ROTA_APP_PASSWORD:-rota_app}
ROTA_ADMIN_PASSWORD=${ROTA_ADMIN_PASSWORD:-rota_admin}
ROTA_PLATFORM_PASSWORD=${ROTA_PLATFORM_PASSWORD:-rota_platform}

# URL do papel rota_provisioner (CREATEDB/CREATEROLE, sem superusuário) — só o
# papel worker recebe (Plano 4).
PROVISIONER_DATABASE_URL=${PROVISIONER_DATABASE_URL:?defina no .env.development.local}

# Banco de plataforma e banco vazio do shard `bootstrap` (ver config/database.yml).
PLATFORM_DATABASE_URL=${PLATFORM_DATABASE_URL:-postgres://127.0.0.1:5432/rota_saude_platform_development}
CITY_UNSET_DATABASE_URL=${CITY_UNSET_DATABASE_URL:-postgres://127.0.0.1:5432/rota_saude_no_city_selected}

# Active Record Encryption.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=${ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY:?defina no .env.development.local}
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=${ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY:?defina no .env.development.local}
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=${ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT:?defina no .env.development.local}

# gov.br OIDC (staging). Vazio = login gov.br responde 502 em dev.
GOVBR_CLIENT_ID=${GOVBR_CLIENT_ID:-}
GOVBR_CLIENT_SECRET=${GOVBR_CLIENT_SECRET:-}

# WhatsApp Cloud API — tokens de sandbox em dev.
WHATSAPP_VERIFY_TOKEN=${WHATSAPP_VERIFY_TOKEN:?defina no .env.development.local}
WHATSAPP_APP_SECRET=${WHATSAPP_APP_SECRET:?defina no .env.development.local}
WHATSAPP_ACCESS_TOKEN=${WHATSAPP_ACCESS_TOKEN:?defina no .env.development.local}
