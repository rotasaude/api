# Kamal secrets — production
# Lido pelo Kamal como shell script. Valores são puxados do 1Password CLI (`op`).
# Pré-requisito no host de deploy: `op` instalado e autenticado no cofre rota-saude-prod.
# Ver ADR-0011.

OP_VAULT="rota-saude-prod"

require_op() {
  if ! command -v op >/dev/null 2>&1; then
    echo "1Password CLI (op) não está instalado neste host" >&2
    exit 1
  fi
}
require_op

# Registry (GitHub Container Registry).
KAMAL_REGISTRY_PASSWORD=$(op read "op://${OP_VAULT}/ghcr-bot/token")

# Rails master key — descriptografa config/credentials/production.yml.enc.
RAILS_MASTER_KEY=$(op read "op://${OP_VAULT}/rails-master-key/credential")

# Postgres do accessory (host dedicado).
POSTGRES_PASSWORD=$(op read "op://${OP_VAULT}/postgres/password")
DATABASE_URL="postgres://rota_saude:${POSTGRES_PASSWORD}@db.rota-saude.example:5432/rota_saude_production?sslmode=require"

# Senhas dos papéis Postgres usados pelo app (config/database.yml, production).
ROTA_APP_PASSWORD=$(op read "op://${OP_VAULT}/postgres-roles/rota_app")
ROTA_ADMIN_PASSWORD=$(op read "op://${OP_VAULT}/postgres-roles/rota_admin")
ROTA_PLATFORM_PASSWORD=$(op read "op://${OP_VAULT}/postgres-roles/rota_platform")

# Banco de plataforma (catálogo de cidades, operadores, platform_events).
# Usuário e senha vêm de config/database.yml (rota_platform / ROTA_PLATFORM_PASSWORD).
PLATFORM_DATABASE_URL="postgres://db.rota-saude.example:5432/rota_saude_platform_production?sslmode=require"

# Destino do shard `bootstrap` do CityRecord: banco VAZIO que precisa EXISTIR
# (sem nenhuma tabela) para uma query fora de cidade falhar fechado. NÃO
# reaproveitar DATABASE_URL (ver comentário de city_unset em config/database.yml).
CITY_UNSET_DATABASE_URL="postgres://db.rota-saude.example:5432/rota_saude_no_city_selected?sslmode=require"

# Active Record Encryption (bin/rails db:encryption:init gera os três valores).
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=$(op read "op://${OP_VAULT}/active-record-encryption/primary_key")
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=$(op read "op://${OP_VAULT}/active-record-encryption/deterministic_key")
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=$(op read "op://${OP_VAULT}/active-record-encryption/key_derivation_salt")

# gov.br OIDC — cliente registrado com redirect_uri única em auth.* (Plano 3B).
GOVBR_CLIENT_ID=$(op read "op://${OP_VAULT}/govbr/client_id")
GOVBR_CLIENT_SECRET=$(op read "op://${OP_VAULT}/govbr/client_secret")

# WhatsApp Cloud API — tokens de produção.
WHATSAPP_VERIFY_TOKEN=$(op read "op://${OP_VAULT}/whatsapp/verify_token")
WHATSAPP_APP_SECRET=$(op read "op://${OP_VAULT}/whatsapp/app_secret")
WHATSAPP_ACCESS_TOKEN=$(op read "op://${OP_VAULT}/whatsapp/access_token")
