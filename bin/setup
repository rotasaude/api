#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  puts "[setup] bundle install"
  system!("bundle check") || system!("bundle install")

  # Plano 5: não há mais banco compartilhado, e nenhum installer de Solid
  # Queue/Cache deve rodar aqui — eles reescreveriam bin/jobs (aposentado),
  # config/queue.yml, config/recurring.yml e config/cache.yml (por cidade e
  # plataforma, geridos à mão). Bootstrap de banco é do start.sh (dev) ou da
  # infra (prod); migrations incrementais são bin/migrate.
  puts "[setup] done — para bootstrap de banco use ./start.sh (dev) e bin/migrate (plataforma + cidades)"
end
